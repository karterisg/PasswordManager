@page "/dashboard"
@using VaultPass.Web.Services
@using VaultPass.Web.Models
@using VaultPass.Web.Shared
@using System.Text.Json
@inject VaultItemService VaultItemService
@inject LocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="dashboard">

    <!-- Topbar -->
    <header class="topbar">
        <div class="topbar-brand">
            <div class="topbar-brand-icon">
                <img src="favicon.png" style="width:100%;height:100%;object-fit:contain" alt="VaultPass" />
            </div>
            VaultPass
        </div>

        <div class="topbar-actions">
            @if (_travelMode)
            {
                <span class="badge badge-warning">Travel Mode</span>
            }
            <button type="button" class="btn btn-ghost btn-icon" title="@(_travelMode ? "Disable Travel Mode" : "Enable Travel Mode")"
                    @onclick="ToggleTravelMode">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 4 19 4c-.34 0-.7.07-1.04.2" />
                    <path d="m3 11 8 2 4-4-5-6" />
                    <path d="M11.1 18.1 5 21l1-5" />
                </svg>
            </button>
            <button type="button" class="btn btn-ghost btn-icon" title="Security Dashboard"
                    @onclick="OpenSecurityModal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
            </button>
            <div class="topbar-divider"></div>
            <button type="button" class="btn btn-ghost btn-icon" title="Export vault"
                    @onclick="ExportVault">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
            </button>
            <button type="button" class="btn btn-ghost btn-icon" title="Import passwords"
                    @onclick="() => _showImportModal = true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" />
                    <line x1="12" y1="3" x2="12" y2="15" />
                </svg>
            </button>
            <div class="topbar-divider"></div>
            <button type="button" class="btn btn-secondary" @onclick="Logout" style="font-size:13px;padding:6px 12px">
                Sign out
            </button>
        </div>
    </header>

    <!-- Content -->
    <main class="dashboard-content">
        <div class="section-header">
            <h2>My Vault</h2>
            <button type="button" class="btn btn-primary" style="width:auto;margin:0;padding:8px 16px"
                    @onclick="OpenAddModal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Add Item
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert-success">@_successMessage</div>
        }
        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert-error">@_globalError</div>
        }

        @if (_loading)
        {
            <p style="color:var(--text-secondary);padding:20px 0">Loading vault…</p>
        }
        else if (_visibleItems.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </div>
                <h3>Your vault is empty</h3>
                <p>Click "Add Item" to save your first password or secret.</p>
            </div>
        }
        else
        {
            @foreach (var group in GetGroupedItems())
            {
                <div class="vault-group">
                    <div class="vault-group-header">
                        <span class="vault-group-icon">@group.Icon</span>
                        <span class="vault-group-name">@group.Name</span>
                        <span class="vault-group-count">@group.Items.Count</span>
                    </div>
                    <div class="vault-list">
                        @foreach (var item in group.Items)
                        {
                            var itemId = item.Id;
                            var revealed = _revealedItems.Contains(itemId);
                            var copied = _copiedId == itemId;
                            var shared = _sharedTokens.ContainsKey(itemId);
                            <div class="vault-item @(item.IsHiddenInTravelMode && _travelMode ? "travel-hidden" : "")">
                                <div class="vault-item-icon">@GetItemIcon(item)</div>
                                <div class="vault-item-info">
                                    <div class="vault-item-name">@item.Name</div>
                                    @if (!string.IsNullOrEmpty(item.WebsiteUrl))
                                    {
                                        <div class="vault-item-url">@item.WebsiteUrl</div>
                                    }
                                    @if (revealed && _decryptedFields.TryGetValue(itemId, out var fields))
                                    {
                                        <div class="vault-item-fields">
                                            @foreach (var kv in fields)
                                            {
                                                <div class="vault-item-field">
                                                    <span class="field-label">@kv.Key</span>
                                                    <span class="field-value">@kv.Value</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="vault-item-actions">
                                    <!-- Reveal -->
                                    <button type="button" class="btn btn-ghost btn-icon"
                                            title="@(revealed ? "Hide" : "Show")"
                                            @onclick="() => ToggleReveal(itemId, item.EncryptedData)">
                                        @if (revealed)
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                                                <line x1="1" y1="1" x2="23" y2="23" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        }
                                    </button>
                                    <!-- Copy -->
                                    <button type="button" class="btn btn-ghost btn-icon"
                                            title="@(copied ? "Copied!" : "Copy password")"
                                            @onclick="() => CopyFirst(itemId, item.EncryptedData)">
                                        @if (copied)
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                            </svg>
                                        }
                                    </button>
                                    <!-- Edit -->
                                    <button type="button" class="btn btn-ghost btn-icon" title="Edit"
                                            @onclick="() => OpenEditModal(item)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                    </button>
                                    <!-- History -->
                                    <button type="button" class="btn btn-ghost btn-icon" title="View history"
                                            @onclick="() => OpenHistoryModal(itemId)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="12 8 12 12 14 14" />
                                            <path d="M3.05 11a9 9 0 1 0 .5-4" />
                                            <polyline points="3 3 3 7 7 7" />
                                        </svg>
                                    </button>
                                    <!-- Share -->
                                    <button type="button" class="btn btn-ghost btn-icon"
                                            title="@(shared ? "Link copied!" : "Share item")"
                                            @onclick="() => ShareItem(itemId)">
                                        @if (shared)
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
                                                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                                                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                                            </svg>
                                        }
                                    </button>
                                    <!-- Travel hidden toggle -->
                                    <button type="button" class="btn btn-ghost btn-icon"
                                            title="@(item.IsHiddenInTravelMode ? "Hidden in Travel Mode" : "Visible in Travel Mode")"
                                            @onclick="() => ToggleItemTravelHidden(item)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                             stroke="@(item.IsHiddenInTravelMode ? "var(--warning)" : "currentColor")"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 4 19 4c-.34 0-.7.07-1.04.2" />
                                            <path d="m3 11 8 2 4-4-5-6" />
                                            <path d="M11.1 18.1 5 21l1-5" />
                                        </svg>
                                    </button>
                                    <!-- Delete -->
                                    <button type="button" class="btn btn-danger btn-icon" title="Delete"
                                            @onclick="() => DeleteItem(itemId)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                            <path d="M10 11v6" /><path d="M14 11v6" />
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </main>
</div>

<!-- Template Picker Modal -->
@if (_showTemplatePicker)
{
    <div class="modal-overlay" @onclick="() => _showTemplatePicker = false">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:480px">
            <div class="modal-header">
                <h3>Choose item type</h3>
                <button type="button" class="modal-close" @onclick="() => _showTemplatePicker = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="template-grid">
                @if (_templates.Count == 0)
                {
                    <p style="color:var(--text-secondary);grid-column:1/-1;text-align:center;padding:20px 0">Loading types…</p>
                }
                @foreach (var t in _templates)
                {
                    var tmpl = t;
                    <button type="button" class="template-btn" @onclick="() => SelectTemplate(tmpl)">
                        <span class="template-btn-icon">@tmpl.Icon</span>
                        <span>@tmpl.Name</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Add / Edit Item Modal -->
@if (_showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editingItem is null ? $"New {_selectedTemplate?.Name ?? "Item"}" : $"Edit — {_editingItem.Name}")</h3>
                <button type="button" class="modal-close" @onclick="CloseModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_addError))
            {
                <div class="alert-error">@_addError</div>
            }
            <div class="form-group">
                <label>Name</label>
                <input class="form-control" placeholder="e.g. Gmail" @bind="_newName" />
            </div>
            <div class="form-group">
                <label>Website URL <span style="color:var(--text-tertiary);font-weight:400">(optional)</span></label>
                <input class="form-control" placeholder="https://gmail.com" @bind="_newUrl" />
            </div>

            @if (_selectedTemplate is not null)
            {
                @foreach (var field in _selectedTemplate.Fields.OrderBy(f => f.Order))
                {
                    var f = field;
                    <div class="form-group">
                        <label>@f.Name @(f.IsRequired ? "" : "")</label>
                        @if (f.FieldType == "Password" || f.IsEncrypted)
                        {
                            <input class="form-control" type="password" placeholder="••••••••"
                                   value="@GetFieldValue(f.Name)"
                                   @oninput="e => SetFieldValue(f.Name, e.Value?.ToString() ?? string.Empty)" />
                        }
                        else if (f.FieldType == "Note")
                        {
                            <textarea class="form-control" rows="3" @bind="_fieldValues[f.Name]"></textarea>
                        }
                        else
                        {
                            <input class="form-control" placeholder="@f.Name"
                                   value="@GetFieldValue(f.Name)"
                                   @oninput="e => SetFieldValue(f.Name, e.Value?.ToString() ?? string.Empty)" />
                        }
                    </div>
                }
            }
            else
            {
                <div class="form-group">
                    <label>Password</label>
                    <input class="form-control" type="password" placeholder="••••••••" @bind="_newPassword" />
                </div>
            }

            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveItem" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

<!-- History Modal -->
@if (_showHistoryModal)
{
    <div class="modal-overlay" @onclick="() => _showHistoryModal = false">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:440px">
            <div class="modal-header">
                <h3>Item history</h3>
                <button type="button" class="modal-close" @onclick="() => _showHistoryModal = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            @if (_history.Count == 0)
            {
                <p style="color:var(--text-secondary);font-size:14px">No previous versions.</p>
            }
            else
            {
                @for (int i = 0; i < _history.Count; i++)
                {
                    var h = _history[i];
                    <div class="history-entry">
                        <div class="history-entry-date">@h.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</div>
                        <div class="history-entry-label">Version @(_history.Count - i)</div>
                    </div>
                }
            }
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="() => _showHistoryModal = false">Close</button>
            </div>
        </div>
    </div>
}

<!-- Security Modal -->
@if (_showSecurityModal)
{
    <div class="modal-overlay" @onclick="() => _showSecurityModal = false">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:520px">
            <div class="modal-header">
                <h3>Security overview</h3>
                <button type="button" class="modal-close" @onclick="() => _showSecurityModal = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            @if (_securityLoading)
            {
                <p style="color:var(--text-secondary);font-size:14px">Analyzing your vault…</p>
            }
            else
            {
                <div class="security-grid">
                    <div class="security-card">
                        <div class="security-score @(_weakCount > 0 ? "bad" : "good")">@_weakCount</div>
                        <div>Weak passwords</div>
                    </div>
                    <div class="security-card">
                        <div class="security-score @(_reusedCount > 0 ? "warn" : "good")">@_reusedCount</div>
                        <div>Reused passwords</div>
                    </div>
                    <div class="security-card">
                        <div class="security-score good">@_items.Count</div>
                        <div>Total items</div>
                    </div>
                </div>
                @if (_weakItems.Count > 0)
                {
                    <p style="font-size:13px;font-weight:600;margin-bottom:8px;color:var(--text-primary)">Items with weak passwords</p>
                    @foreach (var name in _weakItems)
                    {
                        <div class="security-issue">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                            </svg>
                            @name
                        </div>
                    }
                }
            }
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="() => _showSecurityModal = false">Close</button>
            </div>
        </div>
    </div>
}

<!-- Import Modal -->
@if (_showImportModal)
{
    <div class="modal-overlay" @onclick="() => _showImportModal = false">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:460px">
            <div class="modal-header">
                <h3>Import passwords</h3>
                <button type="button" class="modal-close" @onclick="() => _showImportModal = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <p style="font-size:13px;color:var(--text-secondary);margin-bottom:12px">Paste a previously exported VaultPass JSON below.</p>
            <textarea class="form-control" rows="7" @bind="_importJson"
                      style="font-family:'SF Mono','Cascadia Code',monospace;font-size:12px"></textarea>
            @if (!string.IsNullOrEmpty(_importError))
            {
                <div class="alert-error" style="margin-top:10px">@_importError</div>
            }
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="() => _showImportModal = false">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="DoImport">Import</button>
            </div>
        </div>
    </div>
}

@code {
    private List<VaultItemModel> _items = [];
    private List<ItemTemplateModel> _templates = [];
    private bool _loading = true;
    private bool _saving = false;
    private bool _travelMode = false;
    private Guid _vaultId;
    private string? _encKeyBase64;
    private string _globalError = "";
    private string _successMessage = "";

    private bool _showTemplatePicker = false;
    private bool _showModal = false;
    private bool _showHistoryModal = false;
    private bool _showSecurityModal = false;
    private bool _showImportModal = false;

    private VaultItemModel? _editingItem;
    private ItemTemplateModel? _selectedTemplate;
    private string _newName = "";
    private string _newUrl = "";
    private string _newPassword = "";
    private string _addError = "";
    private Dictionary<string, string> _fieldValues = new();

    private HashSet<Guid> _revealedItems = [];
    private Dictionary<Guid, Dictionary<string, string>> _decryptedFields = [];
    private Guid _copiedId = Guid.Empty;
    private Dictionary<Guid, string> _sharedTokens = new();

    private List<VaultItemHistoryModel> _history = [];

    private bool _securityLoading = false;
    private int _weakCount = 0;
    private int _reusedCount = 0;
    private List<string> _weakItems = [];

    private string _importJson = "";
    private string _importError = "";

    private List<VaultItemModel> _visibleItems => _travelMode
        ? _items.Where(i => !i.IsHiddenInTravelMode).ToList()
        : _items;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetAsync("token");
        if (token is null) { Navigation.NavigateTo("/login"); return; }

        _vaultId = ClientUtils.ParseVaultIdFromToken(token);
        if (_vaultId == Guid.Empty) { Navigation.NavigateTo("/login"); return; }

        _encKeyBase64 = await LocalStorage.GetSessionAsync("enc_key");

        try
        {
            _items = await VaultItemService.GetItemsAsync(_vaultId);
            _templates = await VaultItemService.GetTemplatesAsync(_vaultId);
        }
        catch (Exception ex)
        {
            _globalError = "Failed to load vault: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenAddModal()
    {
        _editingItem = null;
        _newName = _newUrl = _newPassword = _addError = "";
        _fieldValues = new();
        _selectedTemplate = null;
        _showTemplatePicker = true;
    }

    private void SelectTemplate(ItemTemplateModel t)
    {
        _selectedTemplate = t;
        _fieldValues = t.Fields.ToDictionary(f => f.Name, _ => "");
        _showTemplatePicker = false;
        _showModal = true;
    }

    private void OpenEditModal(VaultItemModel item)
    {
        _editingItem = item;
        _newName = item.Name;
        _newUrl = item.WebsiteUrl ?? "";
        _newPassword = "";
        _addError = "";
        _selectedTemplate = _templates.FirstOrDefault(t => t.Id == item.TemplateId);
        _fieldValues = _selectedTemplate?.Fields.ToDictionary(f => f.Name, _ => "") ?? new();
        _showModal = true;
    }

    private void CloseModal() { _showModal = false; _editingItem = null; }

    private string GetFieldValue(string name) => _fieldValues.TryGetValue(name, out var v) ? v : "";
    private void SetFieldValue(string name, string value) => _fieldValues[name] = value;

    private async Task SaveItem()
    {
        if (_saving) return;
        _addError = "";
        if (string.IsNullOrWhiteSpace(_newName)) { _addError = "Name is required."; return; }
        _saving = true;

        try
        {
            string encryptedData;
            if (_selectedTemplate is not null)
            {
                var encFields = new Dictionary<string, string>();
                foreach (var field in _selectedTemplate.Fields)
                {
                    var val = _fieldValues.TryGetValue(field.Name, out var v) ? v : "";
                    encFields[field.Name] = field.IsEncrypted ? await EncryptAsync(val) : val;
                }
                encryptedData = await EncryptAsync(JsonSerializer.Serialize(encFields));
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_newPassword)) { _addError = "Password is required."; return; }
                encryptedData = await EncryptAsync(_newPassword);
            }

            bool ok;
            if (_editingItem is null)
            {
                ok = await VaultItemService.CreateItemAsync(new CreateVaultItemRequest(
                    _vaultId, _newName, 1, encryptedData,
                    string.IsNullOrEmpty(_newUrl) ? null : _newUrl,
                    _selectedTemplate?.Id));
            }
            else
            {
                ok = await VaultItemService.UpdateItemAsync(_editingItem.Id, _newName, encryptedData,
                    string.IsNullOrEmpty(_newUrl) ? null : _newUrl);
            }

            if (ok)
            {
                CloseModal();
                _items = await VaultItemService.GetItemsAsync(_vaultId);
            }
            else
            {
                _addError = "Failed to save. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _addError = "Error: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleReveal(Guid id, string encryptedData)
    {
        if (_revealedItems.Contains(id)) { _revealedItems.Remove(id); return; }

        if (!_decryptedFields.ContainsKey(id))
        {
            var plain = await DecryptAsync(encryptedData);
            Dictionary<string, string> fields;
            try
            {
                var parsed = JsonSerializer.Deserialize<Dictionary<string, string>>(plain);
                fields = parsed ?? new Dictionary<string, string> { ["Password"] = plain };
            }
            catch { fields = new Dictionary<string, string> { ["Password"] = plain }; }
            _decryptedFields[id] = fields;
        }
        _revealedItems.Add(id);
    }

    private async Task CopyFirst(Guid itemId, string encryptedData)
    {
        string val;
        if (_decryptedFields.TryGetValue(itemId, out var fields))
            val = fields.Values.FirstOrDefault() ?? "";
        else
        {
            var plain = await DecryptAsync(encryptedData);
            try
            {
                var parsed = JsonSerializer.Deserialize<Dictionary<string, string>>(plain);
                val = parsed?.Values.FirstOrDefault() ?? plain;
            }
            catch { val = plain; }
        }
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", val); } catch { }
        _copiedId = itemId;
        StateHasChanged();
        await Task.Delay(1500);
        _copiedId = Guid.Empty;
        StateHasChanged();
    }

    private async Task DeleteItem(Guid id)
    {
        _revealedItems.Remove(id);
        _decryptedFields.Remove(id);
        await VaultItemService.DeleteItemAsync(id);
        _items = await VaultItemService.GetItemsAsync(_vaultId);
    }

    private async Task OpenHistoryModal(Guid itemId)
    {
        _history = await VaultItemService.GetHistoryAsync(itemId);
        _showHistoryModal = true;
    }

    private async Task ShareItem(Guid itemId)
    {
        var token = await VaultItemService.CreateShareAsync(itemId);
        if (token is null) return;
        var url = Navigation.BaseUri + $"shared/{token}";
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", url); } catch { }
        _sharedTokens[itemId] = token;
        StateHasChanged();
        await Task.Delay(2000);
        _sharedTokens.Remove(itemId);
        StateHasChanged();
    }

    private async Task ToggleTravelMode()
    {
        _travelMode = !_travelMode;
        await VaultItemService.SetTravelModeAsync(_vaultId, _travelMode);
    }

    private async Task ToggleItemTravelHidden(VaultItemModel item)
    {
        await VaultItemService.SetItemTravelHiddenAsync(item.Id, !item.IsHiddenInTravelMode);
        _items = await VaultItemService.GetItemsAsync(_vaultId);
    }

    private async Task ExportVault()
    {
        var data = await VaultItemService.ExportAsync(_vaultId);
        var json = JsonSerializer.Serialize(data, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("downloadFile", "vaultpass-export.json", json);
    }

    private async Task DoImport()
    {
        _importError = "";
        try
        {
            var items = JsonSerializer.Deserialize<List<ImportItemDto>>(_importJson);
            if (items is null || items.Count == 0) { _importError = "No items found in the file."; return; }
            var count = await VaultItemService.ImportAsync(_vaultId, items);
            _showImportModal = false;
            _importJson = "";
            _items = await VaultItemService.GetItemsAsync(_vaultId);
            await ShowSuccess($"Successfully imported {count} item{(count == 1 ? "" : "s")}.");
        }
        catch (Exception ex)
        {
            _importError = "Invalid format: " + ex.Message;
        }
    }

    private async Task OpenSecurityModal()
    {
        _showSecurityModal = true;
        _securityLoading = true;
        StateHasChanged();
        await RunSecurityAnalysis();
    }

    private async Task RunSecurityAnalysis()
    {
        _weakCount = 0; _reusedCount = 0; _weakItems = [];
        var passwords = new List<(string Name, string Plain)>();

        foreach (var item in _items)
        {
            try
            {
                var plain = await DecryptAsync(item.EncryptedData);
                string pwd;
                try
                {
                    var d = JsonSerializer.Deserialize<Dictionary<string, string>>(plain);
                    pwd = d?.Values.FirstOrDefault() ?? plain;
                }
                catch { pwd = plain; }
                if (!string.IsNullOrEmpty(pwd)) passwords.Add((item.Name, pwd));
            }
            catch { }
        }

        foreach (var (name, pwd) in passwords)
        {
            if (pwd.Length < 8 || !pwd.Any(char.IsUpper) || !pwd.Any(char.IsDigit))
            {
                _weakCount++;
                _weakItems.Add(name);
            }
        }

        var grouped = passwords.GroupBy(p => p.Plain).Where(g => g.Count() > 1);
        _reusedCount = grouped.SelectMany(g => g).Count();
        _securityLoading = false;
    }

    private async Task ShowSuccess(string message)
    {
        _successMessage = message;
        StateHasChanged();
        await Task.Delay(3500);
        _successMessage = "";
        StateHasChanged();
    }

    private async Task<string> EncryptAsync(string plaintext)
    {
        if (_encKeyBase64 is null) return plaintext;
        return await JS.InvokeAsync<string>("vaultCrypto.encrypt", _encKeyBase64, plaintext);
    }

    private async Task<string> DecryptAsync(string encryptedData)
    {
        if (_encKeyBase64 is null) return encryptedData;
        try { return await JS.InvokeAsync<string>("vaultCrypto.decrypt", _encKeyBase64, encryptedData); }
        catch { return encryptedData; }
    }

    private string GetItemIcon(VaultItemModel item)
    {
        if (!item.TemplateId.HasValue) return "🔑";
        var t = _templates.FirstOrDefault(t => t.Id == item.TemplateId);
        return t?.Icon ?? "🔑";
    }

    private record VaultGroup(string Icon, string Name, List<VaultItemModel> Items);

    private List<VaultGroup> GetGroupedItems()
    {
        var groups = new List<VaultGroup>();
        foreach (var g in _visibleItems.Where(i => i.TemplateId.HasValue).GroupBy(i => i.TemplateId!.Value))
        {
            var tmpl = _templates.FirstOrDefault(t => t.Id == g.Key);
            if (tmpl is not null) groups.Add(new VaultGroup(tmpl.Icon, tmpl.Name, g.ToList()));
        }
        var untyped = _visibleItems.Where(i => !i.TemplateId.HasValue).ToList();
        if (untyped.Count > 0) groups.Add(new VaultGroup("🔑", "Passwords", untyped));
        return groups;
    }

    private async Task Logout()
    {
        await LocalStorage.RemoveAsync("token");
        await LocalStorage.RemoveSessionAsync("enc_key");
        Navigation.NavigateTo("/login");
    }
