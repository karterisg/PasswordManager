@page "/login"
@using VaultPass.Web.Services
@using VaultPass.Web.Shared
@inject AuthService AuthService
@inject LocalStorageService LocalStorage
@inject NavigationManager Navigation

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <img src="favicon.png" class="auth-logo-icon" alt="VaultPass" />
            <h1>VaultPass</h1>
        </div>
        <h2>Welcome back</h2>
        <p class="auth-subtitle">Sign in to your vault</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert-error">@_error</div>
        }

        <div class="form-group">
            <label for="email">Email</label>
            <input id="email" class="form-control" type="email" placeholder="you@example.com"
                   @bind="_email" @onkeydown="OnKeyDown" />
        </div>
        <div class="form-group">
            <label for="password">Master Password</label>
            <input id="password" class="form-control" type="password" placeholder="••••••••"
                   @bind="_password" @onkeydown="OnKeyDown" />
        </div>
        <button class="btn btn-primary" @onclick="HandleLogin" disabled="@_loading">
            @(_loading ? "Signing in…" : "Sign In")
        </button>

        <p class="auth-footer">Don't have an account? <a href="/register">Create one</a></p>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string _error = "";
    private bool _loading = false;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    private async Task HandleLogin()
    {
        if (_loading) return;
        _error = "";
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Please enter your email and password.";
            return;
        }

        _loading = true;
        try
        {
            var hash = ClientUtils.ComputeSha256(_password);
            var token = await AuthService.LoginAsync(_email.Trim().ToLower(), hash);

            if (token is null)
            {
                _error = "Invalid email or password.";
                return;
            }

            await LocalStorage.SetAsync("token", token);

            var vaultId = ClientUtils.ParseVaultIdFromToken(token);
            if (vaultId != Guid.Empty)
            {
                var encKeyBase64 = EncryptionService.DeriveKeyBase64(hash, vaultId.ToString());
                await LocalStorage.SetSessionAsync("enc_key", encKeyBase64);
            }

            Navigation.NavigateTo("/dashboard");
        }
        catch
        {
            _error = "Could not connect to the server. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
