@page "/register"
@using VaultPass.Web.Services
@using VaultPass.Web.Shared
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <img src="favicon.png" class="auth-logo-icon" alt="VaultPass" />
            <h1>VaultPass</h1>
        </div>
        <h2>Create account</h2>
        <p class="auth-subtitle">Start securing your passwords</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert-error">@_error</div>
        }

        <div class="form-group">
            <label for="name">Display Name</label>
            <input id="name" class="form-control" type="text" placeholder="Your name" @bind="_displayName" />
        </div>
        <div class="form-group">
            <label for="email">Email</label>
            <input id="email" class="form-control" type="email" placeholder="you@example.com" @bind="_email" />
        </div>
        <div class="form-group">
            <label for="password">Master Password</label>
            <input id="password" class="form-control" type="password" placeholder="At least 8 characters" @bind="_password" />
        </div>
        <button class="btn btn-primary" @onclick="HandleRegister" disabled="@_loading">
            @(_loading ? "Creating account…" : "Create Account")
        </button>

        <p class="auth-footer">Already have an account? <a href="/login">Sign in</a></p>
    </div>
</div>

@code {
    private string _displayName = "";
    private string _email = "";
    private string _password = "";
    private string _error = "";
    private bool _loading = false;

    private async Task HandleRegister()
    {
        if (_loading) return;
        _error = "";

        if (string.IsNullOrWhiteSpace(_displayName)) { _error = "Display name is required."; return; }
        if (string.IsNullOrWhiteSpace(_email)) { _error = "Email is required."; return; }
        if (_password.Length < 8) { _error = "Master password must be at least 8 characters."; return; }

        _loading = true;
        try
        {
            var hash = ClientUtils.ComputeSha256(_password);
            var success = await AuthService.RegisterAsync(_email.Trim().ToLower(), _displayName.Trim(), hash);

            if (!success)
            {
                _error = "Registration failed. This email may already be registered.";
                return;
            }

            Navigation.NavigateTo("/login");
        }
        catch
        {
            _error = "Could not connect to the server. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
