@page "/recovery-show"
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-logo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
        </div>
        <h1>Recovery Code</h1>
        <p class="auth-subtitle">Save this code somewhere safe. If you forget your PIN, you'll need it to recover your vault.</p>

        <div class="recovery-code-box">
            <span class="recovery-code">@_code</span>
            <button class="btn-icon" title="Copy" @onclick="CopyCode">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
            </button>
        </div>

        @if (_copied)
        {
            <p class="pin-hint" style="color:var(--accent)">Copied to clipboard!</p>
        }

        <p class="recovery-warning">⚠️ This code will not be shown again. Write it down or store it securely.</p>

        <button class="btn btn-primary" style="width:100%;margin-top:24px" @onclick="Continue">
            I've written it down
        </button>
    </div>
</div>

@code {
    private string _code = "";
    private bool _copied;

    protected override void OnInitialized()
    {
        _code = RecoveryCodeState.PendingCode ?? "ERROR";
        RecoveryCodeState.PendingCode = null;
    }

    private async Task CopyCode()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _code);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }

    private void Continue() => Nav.NavigateTo("/dashboard", true);
}
