{
  "ConnectionStrings": {
    "DefaultConnection": "Server=db;Database=VaultPassDb;User Id=sa;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY_MIN_32_CHARS_CHANGE_THIS",
    "Issuer": "VaultPass.API",
    "Audience": "VaultPass.Clients",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "SeqUrl": ""
  },
  "CorsOrigins": "http://localhost:5002,https://localhost:7120",
  "AllowedHosts": "*"
}
