# Copy this file to .env and fill in your values
# Never commit .env to git

# SQL Server password (min 8 chars, must include uppercase, lowercase, digit, special char)
SQL_PASSWORD=YourStr0ng!Password

# JWT secret key (min 32 characters, random string)
JWT_SECRET=change-this-to-a-random-32-char-string!!

# CORS origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:5002
